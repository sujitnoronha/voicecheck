# VoiceCheck environment variables
# Copy this file to .env and fill in your values

# ── LiveKit (direct mode) ──
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
VOICECHECK_AGENT_NAME=your-agent-name

# ── Token Server (token_server mode) ──
TOKEN_SERVER_URL=http://localhost:8000
FIREBASE_TEST_TOKEN=your-firebase-test-token
TEST_KID_ID=uuid-of-test-kid
TEST_AGENT_ID=uuid-of-test-character

# ── Daily transport ──
DAILY_API_KEY=your-daily-api-key

# ── Retell transport ──
RETELL_API_KEY=your-retell-api-key
RETELL_AGENT_ID=your-retell-agent-id

# ── Vapi transport ──
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-vapi-assistant-id

# ── LLM Judge / Persona conversations ──
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
