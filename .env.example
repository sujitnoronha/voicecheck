# VoiceCheck environment variables
# Copy this file to .env and fill in your values

# ── LiveKit (for direct mode) ──
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
VOICECHECK_AGENT_NAME=your-agent-name

# ── Token Server (for token_server mode) ──
TOKEN_SERVER_URL=http://localhost:8000
FIREBASE_TEST_TOKEN=your-firebase-test-token
TEST_KID_ID=uuid-of-test-kid
TEST_AGENT_ID=uuid-of-test-character

# ── LLM Judge (for llm_judge evaluator) ──
OPENAI_API_KEY=sk-your-openai-key

# ── Persona Conversations ──
# Uses the same OPENAI_API_KEY above
